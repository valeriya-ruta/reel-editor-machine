Dialogue: 0,0:00:00.01,0:00:01.16,S,,0,0,0,,Привіт-привіт, мене звати
Dialogue: 0,0:00:01.18,0:00:02.54,S,,0,0,0,,Рута, я технічна продюсерка
Dialogue: 0,0:00:02.56,0:00:04.16,S,,0,0,0,,твоїх улюблених блогерів
Dialogue: 0,0:00:04.18,0:00:05.38,S,,0,0,0,,а також експертка по
Dialogue: 0,0:00:05.40,0:00:06.78,S,,0,0,0,,автоматизації та впровадженню
Dialogue: 0,0:00:06.80,0:00:08.52,S,,0,0,0,,штучного інтелекту в бізнесі.
Dialogue: 0,0:00:08.54,0:00:09.38,S,,0,0,0,,І ти тут
Dialogue: 0,0:00:09.40,0:00:11.06,S,,0,0,0,,тому що ти побачила останні
Dialogue: 0,0:00:11.08,0:00:12.94,S,,0,0,0,,мої 20-30 рілсів
Dialogue: 0,0:00:12.96,0:00:13.60,S,,0,0,0,,і ти знаєш
Dialogue: 0,0:00:13.62,0:00:16.10,S,,0,0,0,,що всі вони змонтовані
Dialogue: 0,0:00:16.12,0:00:18.30,S,,0,0,0,,повністю від нуля до кінця
Dialogue: 0,0:00:18.32,0:00:19.96,S,,0,0,0,,штучним інтелектом.
Dialogue: 0,0:00:19.98,0:00:21.52,S,,0,0,0,,Я не зробила нічого
Dialogue: 0,0:00:21.54,0:00:22.96,S,,0,0,0,,ні один крок для того
Dialogue: 0,0:00:22.98,0:00:24.29,S,,0,0,0,,щоб вони були змонтовані.
Dialogue: 0,0:00:24.31,0:00:26.05,S,,0,0,0,,І мої каруселі також були
Dialogue: 0,0:00:26.07,0:00:27.69,S,,0,0,0,,задизайнені штучним
Dialogue: 0,0:00:27.71,0:00:29.49,S,,0,0,0,,інтелектом. А ще більше я
Dialogue: 0,0:00:29.51,0:00:31.77,S,,0,0,0,,скажу, що сценарії цих рілсів
Dialogue: 0,0:00:31.79,0:00:33.95,S,,0,0,0,,і тексти цих каруселей також
Dialogue: 0,0:00:33.97,0:00:35.23,S,,0,0,0,,були написані штучним
Dialogue: 0,0:00:35.25,0:00:37.37,S,,0,0,0,,етелектом. Абсолютно повністю
Dialogue: 0,0:00:37.39,0:00:37.95,S,,0,0,0,,з нуля.
Dialogue: 0,0:00:37.97,0:00:40.01,S,,0,0,0,,Я дала лише свою експертизу
Dialogue: 0,0:00:40.03,0:00:40.79,S,,0,0,0,,свою основу
Dialogue: 0,0:00:40.81,0:00:41.59,S,,0,0,0,,свою базу
Dialogue: 0,0:00:41.63,0:00:42.31,S,,0,0,0,,що я хочу
Dialogue: 0,0:00:42.33,0:00:43.25,S,,0,0,0,,свою стратегію.
Dialogue: 0,0:00:43.27,0:00:44.76,S,,0,0,0,,Ми побрейнштормили
Dialogue: 0,0:00:44.78,0:00:47.10,S,,0,0,0,,і я отримала купу-купу
Dialogue: 0,0:00:47.12,0:00:49.40,S,,0,0,0,,контенту. І тепер я спокійно
Dialogue: 0,0:00:49.42,0:00:52.18,S,,0,0,0,,постю 10-15 рілсів на тиждень
Dialogue: 0,0:00:52.20,0:00:54.46,S,,0,0,0,,настільки, що я не встигаю
Dialogue: 0,0:00:54.48,0:00:55.76,S,,0,0,0,,зробити сторіс
Dialogue: 0,0:00:55.78,0:00:57.58,S,,0,0,0,,Я не встигаю зробити
Dialogue: 0,0:00:57.60,0:00:59.08,S,,0,0,0,,лід-магніти, і я не встигаю
Dialogue: 0,0:00:59.10,0:01:00.38,S,,0,0,0,,зробити все інше
Dialogue: 0,0:01:00.48,0:01:01.52,S,,0,0,0,,на чого я веду в
Dialogue: 0,0:01:01.54,0:01:02.14,S,,0,0,0,,своїх рілсах.
Dialogue: 0,0:01:02.16,0:01:04.38,S,,0,0,0,,Настільки швидко я роблю свій
Dialogue: 0,0:01:04.40,0:01:06.46,S,,0,0,0,,новий контент тепер.
Dialogue: 0,0:01:06.48,0:01:07.00,S,,0,0,0,,І тут
Dialogue: 0,0:01:07.04,0:01:08.14,S,,0,0,0,,тому що ти також хочеш
Dialogue: 0,0:01:08.16,0:01:08.68,S,,0,0,0,,це робити
Dialogue: 0,0:01:08.70,0:01:10.46,S,,0,0,0,,тому що ти крута блогерка
Dialogue: 0,0:01:10.58,0:01:11.02,S,,0,0,0,,ти, мабуть
Dialogue: 0,0:01:11.04,0:01:12.00,S,,0,0,0,,підприємниця, ти
Dialogue: 0,0:01:12.02,0:01:13.07,S,,0,0,0,,мабуть, SMM-ниця
Dialogue: 0,0:01:13.09,0:01:14.04,S,,0,0,0,,і ти хочеш також.
Dialogue: 0,0:01:14.06,0:01:15.20,S,,0,0,0,,Тому в цьому відео я
Dialogue: 0,0:01:15.22,0:01:17.48,S,,0,0,0,,покажу, як зробити основу
Dialogue: 0,0:01:17.50,0:01:19.52,S,,0,0,0,,базу всього того
Dialogue: 0,0:01:19.54,0:01:20.92,S,,0,0,0,,що можна задизайнити і
Dialogue: 0,0:01:20.94,0:01:22.28,S,,0,0,0,,змонтувати. І це те
Dialogue: 0,0:01:22.30,0:01:24.12,S,,0,0,0,,що називається StyleMD
Dialogue: 0,0:01:24.14,0:01:25.46,S,,0,0,0,,або як я це називаю?
Dialogue: 0,0:01:25.48,0:01:27.02,S,,0,0,0,,Дизайн-система, тому що так це
Dialogue: 0,0:01:27.04,0:01:28.32,S,,0,0,0,,називається в Клоді.
Dialogue: 0,0:01:28.44,0:01:28.90,S,,0,0,0,,Перед тим
Dialogue: 0,0:01:28.92,0:01:29.94,S,,0,0,0,,як ми перейдемо далі
Dialogue: 0,0:01:29.96,0:01:31.46,S,,0,0,0,,я хочу трошечки пояснити
Dialogue: 0,0:01:31.48,0:01:32.90,S,,0,0,0,,що таке StyleMD
Dialogue: 0,0:01:33.04,0:01:34.72,S,,0,0,0,,точніше оця частинка MD
Dialogue: 0,0:01:34.90,0:01:35.82,S,,0,0,0,,тому що мені здається
Dialogue: 0,0:01:35.84,0:01:38.26,S,,0,0,0,,що люди люблять покривати це
Dialogue: 0,0:01:38.28,0:01:39.56,S,,0,0,0,,все трошечки якоюсь
Dialogue: 0,0:01:39.58,0:01:43.35,S,,0,0,0,,секретністю, а насправді MD –
Dialogue: 0,0:01:43.37,0:01:45.35,S,,0,0,0,,це просто розширення файлу
Dialogue: 0,0:01:45.41,0:01:46.87,S,,0,0,0,,який штучний інтелект щитує
Dialogue: 0,0:01:46.89,0:01:48.29,S,,0,0,0,,найкраще. Так само
Dialogue: 0,0:01:48.31,0:01:49.49,S,,0,0,0,,як у нас є Excel
Dialogue: 0,0:01:49.52,0:01:50.75,S,,0,0,0,,Doc, PDF
Dialogue: 0,0:01:50.94,0:01:51.54,S,,0,0,0,,MD –
Dialogue: 0,0:01:51.56,0:01:53.14,S,,0,0,0,,це просто розширення файлу.
Dialogue: 0,0:01:53.16,0:01:54.52,S,,0,0,0,,І це просто той формат
Dialogue: 0,0:01:54.54,0:01:56.08,S,,0,0,0,,в якому будь-який штучний
Dialogue: 0,0:01:56.10,0:01:57.94,S,,0,0,0,,інтелект може згенерувати сам
Dialogue: 0,0:01:57.96,0:02:00.58,S,,0,0,0,,собі інструкції і пам'ять і
Dialogue: 0,0:02:00.60,0:02:01.76,S,,0,0,0,,зберегти це в своїх
Dialogue: 0,0:02:01.78,0:02:03.00,S,,0,0,0,,налаштуваннях або в тебе на
Dialogue: 0,0:02:03.02,0:02:04.14,S,,0,0,0,,комп'ютері, в залежності від
Dialogue: 0,0:02:04.16,0:02:05.10,S,,0,0,0,,того, як воно там в
Dialogue: 0,0:02:05.12,0:02:05.99,S,,0,0,0,,тебе відбувається.
Dialogue: 0,0:02:06.01,0:02:08.03,S,,0,0,0,,Тому, коли я кажу StyleMD
Dialogue: 0,0:02:08.11,0:02:09.39,S,,0,0,0,,я маю на увазі просто
Dialogue: 0,0:02:09.41,0:02:10.63,S,,0,0,0,,дизайн-системи. Це просто
Dialogue: 0,0:02:10.65,0:02:11.65,S,,0,0,0,,великий документ
Dialogue: 0,0:02:11.67,0:02:12.73,S,,0,0,0,,вважаєте, брендбук
Dialogue: 0,0:02:12.75,0:02:15.87,S,,0,0,0,,в якому описано мовою агента
Dialogue: 0,0:02:15.99,0:02:17.79,S,,0,0,0,,як ми будемо робити дизайн
Dialogue: 0,0:02:17.81,0:02:19.27,S,,0,0,0,,монтаж і так далі.
Dialogue: 0,0:02:19.52,0:02:21.47,S,,0,0,0,,Як взагалі працює ця система?
Dialogue: 0,0:02:21.49,0:02:23.07,S,,0,0,0,,У нас є наш основний
Dialogue: 0,0:02:23.09,0:02:23.75,S,,0,0,0,,StyleMD
Dialogue: 0,0:02:23.77,0:02:25.49,S,,0,0,0,,наша основна дизайн-система
Dialogue: 0,0:02:25.51,0:02:26.67,S,,0,0,0,,база, брендбук.
Dialogue: 0,0:02:26.69,0:02:27.18,S,,0,0,0,,Це там
Dialogue: 0,0:02:27.20,0:02:29.41,S,,0,0,0,,де ми описуємо наші кольори
Dialogue: 0,0:02:29.43,0:02:31.09,S,,0,0,0,,типографіку, тобто шрифти
Dialogue: 0,0:02:31.39,0:02:33.37,S,,0,0,0,,елементи, стиль
Dialogue: 0,0:02:33.53,0:02:34.59,S,,0,0,0,,якісь додаткові штуки.
Dialogue: 0,0:02:34.61,0:02:35.95,S,,0,0,0,,Це наша основа
Dialogue: 0,0:02:35.97,0:02:36.49,S,,0,0,0,,тобто це те
Dialogue: 0,0:02:36.51,0:02:38.95,S,,0,0,0,,що задає рух всьому іншому
Dialogue: 0,0:02:38.97,0:02:40.93,S,,0,0,0,,дизайну. Тобто таким чином на
Dialogue: 0,0:02:40.95,0:02:41.95,S,,0,0,0,,основі цього у нас не
Dialogue: 0,0:02:41.97,0:02:42.37,S,,0,0,0,,вийде так
Dialogue: 0,0:02:42.39,0:02:43.33,S,,0,0,0,,що у нас один рілз
Dialogue: 0,0:02:43.35,0:02:45.23,S,,0,0,0,,оранжевий, інший карусель
Dialogue: 0,0:02:45.25,0:02:47.63,S,,0,0,0,,зелена, інший рілз синій.
Dialogue: 0,0:02:47.65,0:02:48.07,S,,0,0,0,,І, звичайно
Dialogue: 0,0:02:48.09,0:02:49.41,S,,0,0,0,,що ми можемо експериментувати
Dialogue: 0,0:02:49.43,0:02:50.31,S,,0,0,0,,я вам більше скажу
Dialogue: 0,0:02:50.33,0:02:51.71,S,,0,0,0,,ми можемо мати декілька
Dialogue: 0,0:02:51.73,0:02:53.19,S,,0,0,0,,дизайн-систем. Наприклад
Dialogue: 0,0:02:53.21,0:02:54.67,S,,0,0,0,,якщо в тебе є частина
Dialogue: 0,0:02:54.69,0:02:55.81,S,,0,0,0,,контенту персональна
Dialogue: 0,0:02:56.23,0:02:57.61,S,,0,0,0,,а частина контенту експертна
Dialogue: 0,0:02:57.63,0:02:58.97,S,,0,0,0,,як і у більшості нас
Dialogue: 0,0:02:58.99,0:03:00.25,S,,0,0,0,,блогерів, то в тебе можуть
Dialogue: 0,0:03:00.27,0:03:01.57,S,,0,0,0,,бути дві дизайн-системи
Dialogue: 0,0:03:01.59,0:03:03.05,S,,0,0,0,,одна на експертний контент і
Dialogue: 0,0:03:03.07,0:03:04.05,S,,0,0,0,,одна на персональний.
Dialogue: 0,0:03:04.07,0:03:05.47,S,,0,0,0,,І це абсолютно нормально.
Dialogue: 0,0:03:05.55,0:03:07.11,S,,0,0,0,,Але якщо у нас ми
Dialogue: 0,0:03:07.13,0:03:08.73,S,,0,0,0,,поєднаємо її всі в один
Dialogue: 0,0:03:08.75,0:03:09.81,S,,0,0,0,,якби, стиль
Dialogue: 0,0:03:09.91,0:03:11.41,S,,0,0,0,,то наш штучний інтелект
Dialogue: 0,0:03:11.43,0:03:12.43,S,,0,0,0,,він просто заплутається.
Dialogue: 0,0:03:12.45,0:03:13.47,S,,0,0,0,,Він не буде розуміти
Dialogue: 0,0:03:13.49,0:03:13.81,S,,0,0,0,,що є.
Dialogue: 0,0:03:13.83,0:03:15.24,S,,0,0,0,,Тому на кожен стиль у
Dialogue: 0,0:03:15.26,0:03:16.18,S,,0,0,0,,нас є свій брендбук.
Dialogue: 0,0:03:16.20,0:03:16.99,S,,0,0,0,,Що логічно.
Dialogue: 0,0:03:17.01,0:03:18.27,S,,0,0,0,,У нас є основа цього
Dialogue: 0,0:03:18.29,0:03:19.95,S,,0,0,0,,брендбуку. Але далі у нас
Dialogue: 0,0:03:19.97,0:03:21.55,S,,0,0,0,,є також підсекції
Dialogue: 0,0:03:21.57,0:03:22.99,S,,0,0,0,,які ми будемо створювати на
Dialogue: 0,0:03:23.01,0:03:24.45,S,,0,0,0,,кожен тип дизайну
Dialogue: 0,0:03:24.47,0:03:25.53,S,,0,0,0,,тип результату
Dialogue: 0,0:03:25.55,0:03:26.75,S,,0,0,0,,який ми маємо отримати.
Dialogue: 0,0:03:26.78,0:03:28.38,S,,0,0,0,,Тобто, у мене є мій
Dialogue: 0,0:03:28.40,0:03:29.04,S,,0,0,0,,основний брендбук
Dialogue: 0,0:03:29.06,0:03:29.74,S,,0,0,0,,В якому?
Dialogue: 0,0:03:29.90,0:03:31.12,S,,0,0,0,,Базово прописано
Dialogue: 0,0:03:31.14,0:03:33.27,S,,0,0,0,,використовує Product Sans шрифт
Dialogue: 0,0:03:33.29,0:03:35.72,S,,0,0,0,,і темно-червоний колір.
Dialogue: 0,0:03:35.74,0:03:36.24,S,,0,0,0,,Це база
Dialogue: 0,0:03:36.26,0:03:37.00,S,,0,0,0,,це основа
Dialogue: 0,0:03:37.02,0:03:39.79,S,,0,0,0,,все. І я люблю стиль
Dialogue: 0,0:03:39.81,0:03:41.05,S,,0,0,0,,такий трошки еплівський
Dialogue: 0,0:03:41.07,0:03:42.25,S,,0,0,0,,гуглівський, мінімалізм і так
Dialogue: 0,0:03:42.27,0:03:43.41,S,,0,0,0,,далі. Це наша основа
Dialogue: 0,0:03:43.43,0:03:44.25,S,,0,0,0,,основ, це наша база.
Dialogue: 0,0:03:44.27,0:03:45.25,S,,0,0,0,,І далі у нас будуть
Dialogue: 0,0:03:45.27,0:03:46.35,S,,0,0,0,,такі додатки.
Dialogue: 0,0:03:46.46,0:03:48.00,S,,0,0,0,,Додатки під кожен тип.
Dialogue: 0,0:03:48.10,0:03:49.64,S,,0,0,0,,Тобто під карусель у мене
Dialogue: 0,0:03:49.66,0:03:51.14,S,,0,0,0,,окрема секція
Dialogue: 0,0:03:51.26,0:03:52.30,S,,0,0,0,,яка пояснює
Dialogue: 0,0:03:52.32,0:03:53.88,S,,0,0,0,,як ми дизайнуємо саме
Dialogue: 0,0:03:53.90,0:03:55.08,S,,0,0,0,,каруселі. Чому?
Dialogue: 0,0:03:55.10,0:03:56.14,S,,0,0,0,,Тому що у каруселі є
Dialogue: 0,0:03:56.16,0:03:56.75,S,,0,0,0,,свій стиль.
Dialogue: 0,0:03:56.77,0:03:57.99,S,,0,0,0,,Скільки тексту ми можемо
Dialogue: 0,0:03:58.01,0:03:59.23,S,,0,0,0,,розмістити на слайді
Dialogue: 0,0:03:59.27,0:04:01.05,S,,0,0,0,,поки він не вийде за
Dialogue: 0,0:04:01.07,0:04:02.45,S,,0,0,0,,ліміта цього слайду.
Dialogue: 0,0:04:02.55,0:04:04.53,S,,0,0,0,,Який розмір тексту має бути?
Dialogue: 0,0:04:04.55,0:04:06.13,S,,0,0,0,,Як ми розміщимо картинки?
Dialogue: 0,0:04:06.19,0:04:08.03,S,,0,0,0,,Як я люблю розміщати взагалі
Dialogue: 0,0:04:08.05,0:04:09.65,S,,0,0,0,,елементи на слайді?
Dialogue: 0,0:04:09.67,0:04:10.99,S,,0,0,0,,Скільки слайдів ми можемо
Dialogue: 0,0:04:11.01,0:04:12.19,S,,0,0,0,,мати? Взагалі
Dialogue: 0,0:04:12.21,0:04:14.71,S,,0,0,0,,оці всі дизайн-моменти нам
Dialogue: 0,0:04:14.73,0:04:15.63,S,,0,0,0,,дуже важливі.
Dialogue: 0,0:04:15.66,0:04:16.28,S,,0,0,0,,Reels –
Dialogue: 0,0:04:16.30,0:04:17.56,S,,0,0,0,,це взагалі інша історія
Dialogue: 0,0:04:17.58,0:04:18.32,S,,0,0,0,,тому що в Reels'ю у
Dialogue: 0,0:04:18.34,0:04:18.76,S,,0,0,0,,нас є що?
Dialogue: 0,0:04:18.78,0:04:20.08,S,,0,0,0,,У нас є частина зверху
Dialogue: 0,0:04:20.10,0:04:21.64,S,,0,0,0,,де ми не можемо нічого
Dialogue: 0,0:04:21.66,0:04:22.94,S,,0,0,0,,розміщати. Частина знизу
Dialogue: 0,0:04:22.96,0:04:23.82,S,,0,0,0,,де ми не можемо нічого
Dialogue: 0,0:04:23.84,0:04:25.44,S,,0,0,0,,розміщати. По бокам у нас
Dialogue: 0,0:04:25.46,0:04:26.46,S,,0,0,0,,також частини
Dialogue: 0,0:04:26.48,0:04:27.38,S,,0,0,0,,де ми не можемо нічого
Dialogue: 0,0:04:27.40,0:04:28.34,S,,0,0,0,,розміщати, тому що там є
Dialogue: 0,0:04:28.36,0:04:29.38,S,,0,0,0,,інші елементи.
Dialogue: 0,0:04:29.48,0:04:30.92,S,,0,0,0,,Тобто ми маємо прописати
Dialogue: 0,0:04:30.94,0:04:33.14,S,,0,0,0,,що самі важливі елементи
Dialogue: 0,0:04:33.16,0:04:34.56,S,,0,0,0,,які нам треба саме читати
Dialogue: 0,0:04:34.62,0:04:35.76,S,,0,0,0,,вони мають бути розміщені
Dialogue: 0,0:04:35.78,0:04:36.90,S,,0,0,0,,трошки тут
Dialogue: 0,0:04:36.98,0:04:37.88,S,,0,0,0,,за мною
Dialogue: 0,0:04:37.94,0:04:39.12,S,,0,0,0,,субтитри у нас мають бути
Dialogue: 0,0:04:39.14,0:04:40.12,S,,0,0,0,,тут. Тобто у нас є
Dialogue: 0,0:04:40.14,0:04:41.42,S,,0,0,0,,свої правила
Dialogue: 0,0:04:41.44,0:04:42.84,S,,0,0,0,,за якими ми монтуємо рілс
Dialogue: 0,0:04:42.86,0:04:44.18,S,,0,0,0,,правильно, і наш штучний
Dialogue: 0,0:04:44.20,0:04:45.50,S,,0,0,0,,інтелект не буде це знати
Dialogue: 0,0:04:45.52,0:04:47.42,S,,0,0,0,,адекватно, якщо ми це йому
Dialogue: 0,0:04:47.44,0:04:48.26,S,,0,0,0,,не пропишемо.
Dialogue: 0,0:04:48.28,0:04:48.84,S,,0,0,0,,Те саме
Dialogue: 0,0:04:48.86,0:04:50.76,S,,0,0,0,,якщо ти плануєш робити гайди
Dialogue: 0,0:04:50.78,0:04:51.94,S,,0,0,0,,якщо ти любиш дизайну
Dialogue: 0,0:04:51.96,0:04:53.08,S,,0,0,0,,те саме гайди з штучним
Dialogue: 0,0:04:53.10,0:04:55.22,S,,0,0,0,,інтелектом, Тобі потрібна
Dialogue: 0,0:04:55.24,0:04:56.18,S,,0,0,0,,окрема секція
Dialogue: 0,0:04:56.20,0:04:57.20,S,,0,0,0,,окремий додаток
Dialogue: 0,0:04:57.26,0:04:58.56,S,,0,0,0,,який пояснює
Dialogue: 0,0:04:58.58,0:04:59.98,S,,0,0,0,,як ми будемо дизайн за
Dialogue: 0,0:05:00.00,0:05:00.64,S,,0,0,0,,саме гайди.
Dialogue: 0,0:05:00.66,0:05:02.34,S,,0,0,0,,Тому що слайди і гайди
Dialogue: 0,0:05:02.36,0:05:03.40,S,,0,0,0,,як би нам це не
Dialogue: 0,0:05:03.42,0:05:05.14,S,,0,0,0,,здавалося, це абсолютно різні
Dialogue: 0,0:05:05.16,0:05:06.50,S,,0,0,0,,штуки, тому що слайд –
Dialogue: 0,0:05:06.52,0:05:07.13,S,,0,0,0,,це коротко
Dialogue: 0,0:05:07.27,0:05:08.77,S,,0,0,0,,хайпово, маленький
Dialogue: 0,0:05:08.79,0:05:09.55,S,,0,0,0,,великий текст
Dialogue: 0,0:05:09.57,0:05:11.27,S,,0,0,0,,воно дуже швидко гортається.
Dialogue: 0,0:05:11.29,0:05:12.11,S,,0,0,0,,А гайд –
Dialogue: 0,0:05:12.13,0:05:13.25,S,,0,0,0,,це інформація
Dialogue: 0,0:05:13.27,0:05:14.55,S,,0,0,0,,нам її треба не просто
Dialogue: 0,0:05:14.57,0:05:17.55,S,,0,0,0,,х-х-х, нам треба її прочитати
Dialogue: 0,0:05:17.57,0:05:18.90,S,,0,0,0,,і зрозуміти
Dialogue: 0,0:05:18.92,0:05:20.92,S,,0,0,0,,і бажано ще застосувати.
Dialogue: 0,0:05:20.94,0:05:21.91,S,,0,0,0,,І коли у нас так
Dialogue: 0,0:05:21.93,0:05:24.17,S,,0,0,0,,багато тексту і скріншотів
Dialogue: 0,0:05:24.19,0:05:24.91,S,,0,0,0,,і картинок
Dialogue: 0,0:05:24.93,0:05:25.93,S,,0,0,0,,і всього іншого
Dialogue: 0,0:05:26.01,0:05:27.25,S,,0,0,0,,нам треба правильно розмістити
Dialogue: 0,0:05:27.27,0:05:30.01,S,,0,0,0,,цей текст на нашій сторінці
Dialogue: 0,0:05:30.03,0:05:30.88,S,,0,0,0,,в нашому гайді.
Dialogue: 0,0:05:30.90,0:05:31.86,S,,0,0,0,,Саме тому
Dialogue: 0,0:05:31.88,0:05:33.28,S,,0,0,0,,коли ми будемо генерувати наш
Dialogue: 0,0:05:33.30,0:05:33.92,S,,0,0,0,,StyleMD
Dialogue: 0,0:05:33.94,0:05:35.91,S,,0,0,0,,у нас буде основна частина
Dialogue: 0,0:05:35.93,0:05:37.65,S,,0,0,0,,і далі буде кожна секція.
Dialogue: 0,0:05:37.67,0:05:39.25,S,,0,0,0,,І скільки секцій хочеш ти
Dialogue: 0,0:05:39.27,0:05:40.39,S,,0,0,0,,залежить лише від тебе.
Dialogue: 0,0:05:40.44,0:05:40.82,S,,0,0,0,,У мене
Dialogue: 0,0:05:40.84,0:05:41.92,S,,0,0,0,,наприклад, їх лише дві.
Dialogue: 0,0:05:41.94,0:05:45.67,S,,0,0,0,,Це каруселі і монтаж рілсів
Dialogue: 0,0:05:45.69,0:05:46.19,S,,0,0,0,,монтаж відео
Dialogue: 0,0:05:46.21,0:05:48.01,S,,0,0,0,,тому що більше нічого я
Dialogue: 0,0:05:48.03,0:05:49.27,S,,0,0,0,,власне, і не роблю з
Dialogue: 0,0:05:49.29,0:05:50.17,S,,0,0,0,,цим дизайном.
Dialogue: 0,0:05:50.37,0:05:52.11,S,,0,0,0,,Те, що я тут розповім
Dialogue: 0,0:05:52.13,0:05:54.05,S,,0,0,0,,працює абсолютно так само і
Dialogue: 0,0:05:54.07,0:05:54.83,S,,0,0,0,,в ChatGPT
Dialogue: 0,0:05:54.85,0:05:55.65,S,,0,0,0,,і в Клоді.
Dialogue: 0,0:05:55.67,0:05:56.93,S,,0,0,0,,Я працюю в Клоді
Dialogue: 0,0:05:56.95,0:05:58.33,S,,0,0,0,,Клод мені подобається більше
Dialogue: 0,0:05:58.35,0:06:00.39,S,,0,0,0,,я про це кажу усюди
Dialogue: 0,0:06:00.41,0:06:01.49,S,,0,0,0,,постійно. Чому?
Dialogue: 0,0:06:01.51,0:06:02.81,S,,0,0,0,,Тому що в Клоді є
Dialogue: 0,0:06:02.83,0:06:04.15,S,,0,0,0,,своя дизайн-система
Dialogue: 0,0:06:04.17,0:06:06.15,S,,0,0,0,,як функція в самому Клоді.
Dialogue: 0,0:06:06.17,0:06:09.45,S,,0,0,0,,В нього є свій дизайн
Dialogue: 0,0:06:09.47,0:06:10.49,S,,0,0,0,,своя дизайн
Dialogue: 0,0:06:10.51,0:06:11.96,S,,0,0,0,,скажімо, програма
Dialogue: 0,0:06:12.14,0:06:14.12,S,,0,0,0,,така собі фігма на мінімалках
Dialogue: 0,0:06:14.14,0:06:15.78,S,,0,0,0,,в якій дуже просто і
Dialogue: 0,0:06:15.80,0:06:16.92,S,,0,0,0,,легко працювати
Dialogue: 0,0:06:17.52,0:06:19.50,S,,0,0,0,,правити текст і завантажувати
Dialogue: 0,0:06:19.52,0:06:20.64,S,,0,0,0,,потім ці картинки.
Dialogue: 0,0:06:20.72,0:06:22.06,S,,0,0,0,,І що мені ще подобається
Dialogue: 0,0:06:22.08,0:06:22.40,S,,0,0,0,,це те
Dialogue: 0,0:06:22.42,0:06:22.98,S,,0,0,0,,що Клод
Dialogue: 0,0:06:23.00,0:06:24.12,S,,0,0,0,,він не може генерувати
Dialogue: 0,0:06:24.14,0:06:25.56,S,,0,0,0,,картинки. ChatGPT може
Dialogue: 0,0:06:25.58,0:06:26.52,S,,0,0,0,,генерувати картинки
Dialogue: 0,0:06:26.54,0:06:27.24,S,,0,0,0,,тому що в нього є
Dialogue: 0,0:06:27.26,0:06:28.30,S,,0,0,0,,ця модель
Dialogue: 0,0:06:28.36,0:06:29.80,S,,0,0,0,,яка може це генерувати.
Dialogue: 0,0:06:29.82,0:06:33.92,S,,0,0,0,,Клод збирає дизайн як сайт
Dialogue: 0,0:06:33.94,0:06:35.32,S,,0,0,0,,Тобто по елементам.
Dialogue: 0,0:06:35.34,0:06:36.78,S,,0,0,0,,Тут в мене буде прямокутник
Dialogue: 0,0:06:36.80,0:06:37.62,S,,0,0,0,,тут в мене текст.
Dialogue: 0,0:06:37.64,0:06:39.24,S,,0,0,0,,Тут в мене кружечок
Dialogue: 0,0:06:39.26,0:06:41.36,S,,0,0,0,,розблюрений, тут в мене інший
Dialogue: 0,0:06:41.38,0:06:42.73,S,,0,0,0,,текст. ChatGPT може
Dialogue: 0,0:06:42.75,0:06:44.03,S,,0,0,0,,згенерувати картинку.
Dialogue: 0,0:06:44.05,0:06:46.05,S,,0,0,0,,І якщо йому чітко-чітко-чітко
Dialogue: 0,0:06:46.07,0:06:46.75,S,,0,0,0,,не прописати
Dialogue: 0,0:06:46.77,0:06:48.39,S,,0,0,0,,що ти маєш зібрати його
Dialogue: 0,0:06:48.41,0:06:50.23,S,,0,0,0,,як Джейсоном
Dialogue: 0,0:06:50.27,0:06:52.13,S,,0,0,0,,Пайтоном, будь-чим іншим
Dialogue: 0,0:06:52.15,0:06:53.21,S,,0,0,0,,а не просто згенерувати
Dialogue: 0,0:06:53.23,0:06:54.29,S,,0,0,0,,то у нас вийде отай
Dialogue: 0,0:06:54.31,0:06:56.45,S,,0,0,0,,слоп, який ми бачимо постійно
Dialogue: 0,0:06:56.47,0:06:58.37,S,,0,0,0,,який ми так сильно не
Dialogue: 0,0:06:58.39,0:07:00.04,S,,0,0,0,,любимо. Якщо ти вже підписаний
Dialogue: 0,0:07:00.06,0:07:00.66,S,,0,0,0,,на ChatGPT
Dialogue: 0,0:07:00.68,0:07:01.24,S,,0,0,0,,ти не хочеш з нього
Dialogue: 0,0:07:01.26,0:07:02.26,S,,0,0,0,,нікуди рухатись
Dialogue: 0,0:07:02.32,0:07:02.94,S,,0,0,0,,все окей.
Dialogue: 0,0:07:02.96,0:07:05.00,S,,0,0,0,,Ми можемо працювати в ChatGPT
Dialogue: 0,0:07:05.02,0:07:05.30,S,,0,0,0,,все те
Dialogue: 0,0:07:05.32,0:07:06.33,S,,0,0,0,,що я зараз поясню
Dialogue: 0,0:07:06.35,0:07:08.17,S,,0,0,0,,так само буде працювати там.
Dialogue: 0,0:07:08.33,0:07:09.89,S,,0,0,0,,Але якщо ти зараз на
Dialogue: 0,0:07:09.91,0:07:11.05,S,,0,0,0,,роздоріжжі, ти думаєш
Dialogue: 0,0:07:11.07,0:07:12.35,S,,0,0,0,,я не знаю
Dialogue: 0,0:07:12.37,0:07:13.31,S,,0,0,0,,а що мені обрати
Dialogue: 0,0:07:13.33,0:07:14.39,S,,0,0,0,,а я думаю перейти на
Dialogue: 0,0:07:14.41,0:07:15.94,S,,0,0,0,,клод, ти не пошкодуєш.
Dialogue: 0,0:07:15.96,0:07:16.42,S,,0,0,0,,Я думаю
Dialogue: 0,0:07:16.44,0:07:17.86,S,,0,0,0,,ти не пошкодуєш абсолютно
Dialogue: 0,0:07:18.18,0:07:19.08,S,,0,0,0,,тому що клод –
Dialogue: 0,0:07:19.10,0:07:20.34,S,,0,0,0,,це дуже круто
Dialogue: 0,0:07:20.36,0:07:22.42,S,,0,0,0,,це справді дуже зручно.
Dialogue: 0,0:07:22.44,0:07:23.70,S,,0,0,0,,І це кажу не тільки
Dialogue: 0,0:07:23.72,0:07:25.20,S,,0,0,0,,я, це кажуть також всі
Dialogue: 0,0:07:25.22,0:07:25.92,S,,0,0,0,,мої клієнти
Dialogue: 0,0:07:25.94,0:07:27.34,S,,0,0,0,,яких я перевела на цей
Dialogue: 0,0:07:27.36,0:07:29.28,S,,0,0,0,,клод і перепідписали туди
Dialogue: 0,0:07:29.30,0:07:30.50,S,,0,0,0,,і все туди перенесла
Dialogue: 0,0:07:30.52,0:07:31.62,S,,0,0,0,,тому що він дійсно
Dialogue: 0,0:07:31.64,0:07:32.56,S,,0,0,0,,дійсно класний.
Dialogue: 0,0:07:32.58,0:07:33.68,S,,0,0,0,,Але це все лірика
Dialogue: 0,0:07:33.71,0:07:34.97,S,,0,0,0,,тому що тепер ми переходимо
Dialogue: 0,0:07:34.99,0:07:36.85,S,,0,0,0,,до власне створення нашого
Dialogue: 0,0:07:36.87,0:07:38.35,S,,0,0,0,,StyleMD. Погнали!
Dialogue: 0,0:07:38.90,0:07:39.74,S,,0,0,0,,Починамо з того
Dialogue: 0,0:07:39.76,0:07:42.14,S,,0,0,0,,що ми формуємо нашу базу-базу
Dialogue: 0,0:07:42.19,0:07:43.53,S,,0,0,0,,наш базовий брендбук.
Dialogue: 0,0:07:43.55,0:07:45.38,S,,0,0,0,,Ми просто відкриваємо чат в
Dialogue: 0,0:07:45.40,0:07:47.36,S,,0,0,0,,нашому штучному інтелекті і
Dialogue: 0,0:07:47.38,0:07:49.54,S,,0,0,0,,починаємо розписувати йому
Dialogue: 0,0:07:49.56,0:07:50.80,S,,0,0,0,,що ми хочемо.
Dialogue: 0,0:07:50.82,0:07:51.77,S,,0,0,0,,Якщо в тебе вже є
Dialogue: 0,0:07:51.79,0:07:53.11,S,,0,0,0,,якесь чітке розуміння
Dialogue: 0,0:07:53.13,0:07:54.15,S,,0,0,0,,в тебе вже є брендбук
Dialogue: 0,0:07:54.17,0:07:54.49,S,,0,0,0,,в тебе
Dialogue: 0,0:07:54.51,0:07:56.79,S,,0,0,0,,наприклад, вже готовий дизайн
Dialogue: 0,0:07:57.47,0:07:59.17,S,,0,0,0,,задизайнений дизайнером в
Dialogue: 0,0:07:59.19,0:08:00.05,S,,0,0,0,,твоєму образі
Dialogue: 0,0:08:00.07,0:08:01.59,S,,0,0,0,,і ти хочеш просто відтворити
Dialogue: 0,0:08:01.61,0:08:02.98,S,,0,0,0,,це, то тоді ти просто
Dialogue: 0,0:08:03.00,0:08:04.06,S,,0,0,0,,береш скріншоти
Dialogue: 0,0:08:04.08,0:08:05.14,S,,0,0,0,,береш готовий брендбук
Dialogue: 0,0:08:05.16,0:08:06.58,S,,0,0,0,,береш всі елементи і скидаєш
Dialogue: 0,0:08:06.60,0:08:07.18,S,,0,0,0,,їх в чат
Dialogue: 0,0:08:07.20,0:08:09.00,S,,0,0,0,,і просиш відтворити
Dialogue: 0,0:08:09.02,0:08:11.10,S,,0,0,0,,точнісінько так само
Dialogue: 0,0:08:11.40,0:08:12.89,S,,0,0,0,,проаналізувати ці картинки і
Dialogue: 0,0:08:12.91,0:08:14.33,S,,0,0,0,,відтворити точнісінько так
Dialogue: 0,0:08:14.35,0:08:15.32,S,,0,0,0,,само. Якщо ти
Dialogue: 0,0:08:15.34,0:08:15.68,S,,0,0,0,,як я
Dialogue: 0,0:08:15.70,0:08:16.56,S,,0,0,0,,і в тебе є загальне
Dialogue: 0,0:08:16.58,0:08:18.28,S,,0,0,0,,розуміння, хто твоє ЦА
Dialogue: 0,0:08:18.48,0:08:19.66,S,,0,0,0,,які кольори ти любиш
Dialogue: 0,0:08:19.68,0:08:20.64,S,,0,0,0,,який стиль ти хочеш
Dialogue: 0,0:08:20.66,0:08:21.28,S,,0,0,0,,але в тебе не мають
Dialogue: 0,0:08:21.30,0:08:22.76,S,,0,0,0,,суперчіткого розуміння
Dialogue: 0,0:08:22.84,0:08:24.80,S,,0,0,0,,то тоді ми починаємо описувати
Dialogue: 0,0:08:24.82,0:08:26.36,S,,0,0,0,,йому через мудборд.
Dialogue: 0,0:08:26.38,0:08:27.86,S,,0,0,0,,Я люблю описувати
Dialogue: 0,0:08:27.90,0:08:29.40,S,,0,0,0,,яка цільова аудиторія і чому
Dialogue: 0,0:08:29.42,0:08:30.78,S,,0,0,0,,я хочу саме цей стиль
Dialogue: 0,0:08:30.80,0:08:31.84,S,,0,0,0,,тому що мені здається
Dialogue: 0,0:08:31.86,0:08:33.82,S,,0,0,0,,що це дає розуміння загалом
Dialogue: 0,0:08:34.26,0:08:35.64,S,,0,0,0,,навіщо ми робимо так.
Dialogue: 0,0:08:35.66,0:08:36.32,S,,0,0,0,,Тобто зрозуміло
Dialogue: 0,0:08:36.34,0:08:38.11,S,,0,0,0,,що якщо я працюю з
Dialogue: 0,0:08:38.13,0:08:39.61,S,,0,0,0,,дуже великими блогерами
Dialogue: 0,0:08:39.83,0:08:41.33,S,,0,0,0,,20, 50
Dialogue: 0,0:08:41.49,0:08:44.39,S,,0,0,0,,100, 200 тисяч підписників
Dialogue: 0,0:08:44.59,0:08:45.91,S,,0,0,0,,підприємці і так далі
Dialogue: 0,0:08:45.93,0:08:47.57,S,,0,0,0,,В мене не може бути
Dialogue: 0,0:08:47.59,0:08:48.69,S,,0,0,0,,я не хочу мати якийсь
Dialogue: 0,0:08:48.71,0:08:50.37,S,,0,0,0,,супер дитячий стайл
Dialogue: 0,0:08:50.39,0:08:51.51,S,,0,0,0,,я не хочу мати щось
Dialogue: 0,0:08:51.53,0:08:52.75,S,,0,0,0,,таке а-ля
Dialogue: 0,0:08:52.77,0:08:54.69,S,,0,0,0,,я хочу якийсь такий
Dialogue: 0,0:08:54.71,0:08:56.19,S,,0,0,0,,типу, преміум.
Dialogue: 0,0:08:56.29,0:08:57.73,S,,0,0,0,,І я дуже люблю стайл
Dialogue: 0,0:08:57.75,0:08:58.31,S,,0,0,0,,в стилі
Dialogue: 0,0:08:58.33,0:08:59.69,S,,0,0,0,,стиль в стилі Google
Dialogue: 0,0:08:59.75,0:09:00.59,S,,0,0,0,,в стилі Apple.
Dialogue: 0,0:09:00.63,0:09:02.55,S,,0,0,0,,І я так само описую
Dialogue: 0,0:09:02.57,0:09:03.33,S,,0,0,0,,в моєму чаті.
Dialogue: 0,0:09:03.35,0:09:03.99,S,,0,0,0,,Тобто я кажу
Dialogue: 0,0:09:04.01,0:09:05.23,S,,0,0,0,,я хочу такий колір
Dialogue: 0,0:09:05.25,0:09:06.81,S,,0,0,0,,я люблю такий шрифт без
Dialogue: 0,0:09:06.83,0:09:08.54,S,,0,0,0,,засічок і такого всякого.
Dialogue: 0,0:09:08.56,0:09:09.80,S,,0,0,0,,Я хочу ось такий
Dialogue: 0,0:09:09.82,0:09:11.00,S,,0,0,0,,мінімалістичний стиль.
Dialogue: 0,0:09:11.02,0:09:12.36,S,,0,0,0,,І тепер ми йдемо в
Dialogue: 0,0:09:12.38,0:09:13.16,S,,0,0,0,,Пінтерест, можна
Dialogue: 0,0:09:13.18,0:09:13.54,S,,0,0,0,,в принципі
Dialogue: 0,0:09:13.56,0:09:14.56,S,,0,0,0,,піти там в Unsplash
Dialogue: 0,0:09:14.58,0:09:15.30,S,,0,0,0,,в Behance
Dialogue: 0,0:09:15.32,0:09:15.90,S,,0,0,0,,куди завгодно
Dialogue: 0,0:09:15.92,0:09:16.44,S,,0,0,0,,але, як на мене
Dialogue: 0,0:09:16.46,0:09:17.50,S,,0,0,0,,Пінтерест найкращий.
Dialogue: 0,0:09:17.54,0:09:18.54,S,,0,0,0,,Ми йдемо в Пінтерест і
Dialogue: 0,0:09:18.56,0:09:20.34,S,,0,0,0,,починаємо збирати мудборд.
Dialogue: 0,0:09:20.36,0:09:21.88,S,,0,0,0,,Мудборд, про який говорять вже
Dialogue: 0,0:09:21.90,0:09:23.34,S,,0,0,0,,тисячі років.
Dialogue: 0,0:09:23.36,0:09:24.88,S,,0,0,0,,Ми повертаємось до нього
Dialogue: 0,0:09:24.90,0:09:26.30,S,,0,0,0,,і ми починаємо шукати якісь
Dialogue: 0,0:09:26.32,0:09:28.08,S,,0,0,0,,елементи. Причому це може бути
Dialogue: 0,0:09:28.10,0:09:29.14,S,,0,0,0,,приклади реальних штук.
Dialogue: 0,0:09:29.16,0:09:30.12,S,,0,0,0,,Наприклад, я люблю
Dialogue: 0,0:09:30.60,0:09:32.68,S,,0,0,0,,пошукати в Пінтересті дизайн
Dialogue: 0,0:09:32.70,0:09:34.32,S,,0,0,0,,каруселі і подивитися
Dialogue: 0,0:09:34.34,0:09:35.42,S,,0,0,0,,які є дизайни
Dialogue: 0,0:09:35.62,0:09:36.99,S,,0,0,0,,покопіювати, розповісти
Dialogue: 0,0:09:37.01,0:09:38.73,S,,0,0,0,,що мені подобається в кожному
Dialogue: 0,0:09:38.75,0:09:39.91,S,,0,0,0,,слайді. Тобто
Dialogue: 0,0:09:39.93,0:09:41.03,S,,0,0,0,,описати плюс-мінус
Dialogue: 0,0:09:41.05,0:09:41.73,S,,0,0,0,,отак, знаєте
Dialogue: 0,0:09:42.25,0:09:43.39,S,,0,0,0,,крадемо, як художники
Dialogue: 0,0:09:43.41,0:09:44.90,S,,0,0,0,,кожні елементи там і там.
Dialogue: 0,0:09:44.92,0:09:46.22,S,,0,0,0,,Також я йому відправляла
Dialogue: 0,0:09:46.24,0:09:48.06,S,,0,0,0,,елементи з якихось додатків
Dialogue: 0,0:09:48.08,0:09:48.70,S,,0,0,0,,там, де мені просто
Dialogue: 0,0:09:48.72,0:09:50.56,S,,0,0,0,,подобається оцей Liquid Glass
Dialogue: 0,0:09:50.58,0:09:51.24,S,,0,0,0,,якщо ви знаєте
Dialogue: 0,0:09:51.26,0:09:51.76,S,,0,0,0,,що це.
Dialogue: 0,0:09:52.87,0:09:53.98,S,,0,0,0,,Тобто, я йому збирала
Dialogue: 0,0:09:54.00,0:09:54.88,S,,0,0,0,,елементи, які мені
Dialogue: 0,0:09:54.90,0:09:56.06,S,,0,0,0,,подобаються, навіть
Dialogue: 0,0:09:56.08,0:09:57.77,S,,0,0,0,,якщо вони нібито сильно не
Dialogue: 0,0:09:57.79,0:09:58.91,S,,0,0,0,,пов'язані між собою
Dialogue: 0,0:09:58.93,0:10:00.03,S,,0,0,0,,і описувала
Dialogue: 0,0:10:00.05,0:10:01.61,S,,0,0,0,,чому вони мені подобаються.
Dialogue: 0,0:10:01.63,0:10:03.21,S,,0,0,0,,І він мені генерував не
Dialogue: 0,0:10:03.23,0:10:05.19,S,,0,0,0,,просто дизайн-систему
Dialogue: 0,0:10:05.21,0:10:06.33,S,,0,0,0,,він мені генерував також
Dialogue: 0,0:10:06.35,0:10:07.81,S,,0,0,0,,приклади застосування.
Dialogue: 0,0:10:07.83,0:10:09.21,S,,0,0,0,,І це супер важливо.
Dialogue: 0,0:10:09.23,0:10:10.99,S,,0,0,0,,Тому що звичайні люди
Dialogue: 0,0:10:11.01,0:10:12.05,S,,0,0,0,,як ти і я
Dialogue: 0,0:10:12.07,0:10:13.61,S,,0,0,0,,ми не зрозуміємо просто з
Dialogue: 0,0:10:13.63,0:10:14.89,S,,0,0,0,,типографії, з кольорів
Dialogue: 0,0:10:14.91,0:10:15.79,S,,0,0,0,,з якихось елементів
Dialogue: 0,0:10:15.81,0:10:16.83,S,,0,0,0,,як це буде виглядати.
Dialogue: 0,0:10:16.85,0:10:18.03,S,,0,0,0,,Якщо в тебе класно розглянута
Dialogue: 0,0:10:18.05,0:10:19.23,S,,0,0,0,,пам'яті, в тебе було все
Dialogue: 0,0:10:19.25,0:10:20.61,S,,0,0,0,,добре на геометрі
Dialogue: 0,0:10:20.63,0:10:21.03,S,,0,0,0,,то, можливо
Dialogue: 0,0:10:21.05,0:10:22.77,S,,0,0,0,,в тебе є плюс-мінус розуміння.
Dialogue: 0,0:10:22.81,0:10:24.91,S,,0,0,0,,Але зрозуміти і додумати
Dialogue: 0,0:10:24.93,0:10:26.91,S,,0,0,0,,самостійно, це абсолютно інше
Dialogue: 0,0:10:27.03,0:10:27.39,S,,0,0,0,,ніж те
Dialogue: 0,0:10:27.41,0:10:28.79,S,,0,0,0,,як це буде реально виглядати
Dialogue: 0,0:10:28.81,0:10:29.55,S,,0,0,0,,в каруселі.
Dialogue: 0,0:10:29.57,0:10:31.15,S,,0,0,0,,Тому що не кожен дизайн
Dialogue: 0,0:10:31.17,0:10:32.76,S,,0,0,0,,гарно буде виглядати осюди.
Dialogue: 0,0:10:32.78,0:10:34.68,S,,0,0,0,,Тому дуже важливо прописати в
Dialogue: 0,0:10:34.70,0:10:35.52,S,,0,0,0,,промті. Промти я вам
Dialogue: 0,0:10:35.54,0:10:35.86,S,,0,0,0,,до речі
Dialogue: 0,0:10:35.88,0:10:36.52,S,,0,0,0,,всі даю.
Dialogue: 0,0:10:36.62,0:10:38.50,S,,0,0,0,,Ви їх знайдете навколо цього
Dialogue: 0,0:10:38.52,0:10:39.72,S,,0,0,0,,відео, де я їх там
Dialogue: 0,0:10:39.74,0:10:41.42,S,,0,0,0,,завантажу. Ви побачите ці
Dialogue: 0,0:10:41.44,0:10:42.58,S,,0,0,0,,промти. В цих промтах ми
Dialogue: 0,0:10:42.60,0:10:44.88,S,,0,0,0,,просимо його згенерувати.
Dialogue: 0,0:10:44.90,0:10:46.50,S,,0,0,0,,Приклад каруселі.
Dialogue: 0,0:10:46.74,0:10:48.00,S,,0,0,0,,Обкладинка, текст
Dialogue: 0,0:10:48.33,0:10:48.99,S,,0,0,0,,заклик до дій
Dialogue: 0,0:10:49.01,0:10:50.58,S,,0,0,0,,CTA. Приклад сайту.
Dialogue: 0,0:10:50.92,0:10:52.35,S,,0,0,0,,Буквально перший екран.
Dialogue: 0,0:10:52.37,0:10:53.77,S,,0,0,0,,Приклад, як це може бути
Dialogue: 0,0:10:53.79,0:10:54.33,S,,0,0,0,,в монтажі.
Dialogue: 0,0:10:54.35,0:10:57.37,S,,0,0,0,,Тобто ми просимо його показати
Dialogue: 0,0:10:57.39,0:10:58.59,S,,0,0,0,,нам, як це реально буде
Dialogue: 0,0:10:58.61,0:11:00.23,S,,0,0,0,,виглядати. І ми зможемо
Dialogue: 0,0:11:00.25,0:11:01.89,S,,0,0,0,,оцінити, чи читабельний нам
Dialogue: 0,0:11:01.91,0:11:03.65,S,,0,0,0,,текст, Чи подобається нам цей
Dialogue: 0,0:11:03.67,0:11:05.37,S,,0,0,0,,стиль, чи гарні ці кольори
Dialogue: 0,0:11:05.39,0:11:07.33,S,,0,0,0,,разом. І нам буде простіше
Dialogue: 0,0:11:07.35,0:11:08.45,S,,0,0,0,,з цим працювати.
Dialogue: 0,0:11:08.68,0:11:09.58,S,,0,0,0,,Після того
Dialogue: 0,0:11:09.60,0:11:11.12,S,,0,0,0,,як ми це все згенерували
Dialogue: 0,0:11:11.14,0:11:13.34,S,,0,0,0,,ми можемо перейти до додатків.
Dialogue: 0,0:11:13.36,0:11:14.70,S,,0,0,0,,І ми так і просимо
Dialogue: 0,0:11:14.86,0:11:16.03,S,,0,0,0,,додай секцію
Dialogue: 0,0:11:16.05,0:11:17.14,S,,0,0,0,,тададам, наприклад
Dialogue: 0,0:11:17.16,0:11:18.74,S,,0,0,0,,додай секцію каруселі.
Dialogue: 0,0:11:18.76,0:11:20.84,S,,0,0,0,,Зроби мені на основі цього
Dialogue: 0,0:11:20.86,0:11:23.23,S,,0,0,0,,приклад дизайну каруселі в
Dialogue: 0,0:11:23.25,0:11:24.42,S,,0,0,0,,нашому стилі.
Dialogue: 0,0:11:24.44,0:11:25.78,S,,0,0,0,,Використай будь-який текст.
Dialogue: 0,0:11:25.80,0:11:27.18,S,,0,0,0,,Тут можна дати свій текст
Dialogue: 0,0:11:27.20,0:11:28.54,S,,0,0,0,,а можна попросити його просто
Dialogue: 0,0:11:28.56,0:11:29.58,S,,0,0,0,,використати, те
Dialogue: 0,0:11:29.60,0:11:30.72,S,,0,0,0,,що називається «Риба-текст»
Dialogue: 0,0:11:30.74,0:11:31.64,S,,0,0,0,,або «Lorem Ipsum»
Dialogue: 0,0:11:31.66,0:11:33.12,S,,0,0,0,,і просто використати будь-який
Dialogue: 0,0:11:33.14,0:11:34.72,S,,0,0,0,,текст, щоб він просто показав
Dialogue: 0,0:11:34.74,0:11:35.76,S,,0,0,0,,як воно буде.
Dialogue: 0,0:11:35.78,0:11:37.12,S,,0,0,0,,І показати нам декілька
Dialogue: 0,0:11:37.14,0:11:38.14,S,,0,0,0,,прикладів слайдів.
Dialogue: 0,0:11:38.16,0:11:38.50,S,,0,0,0,,Тому ж таки
Dialogue: 0,0:11:38.52,0:11:40.06,S,,0,0,0,,в тому промті вони описані.
Dialogue: 0,0:11:40.08,0:11:40.98,S,,0,0,0,,Тобто ми даємо йому
Dialogue: 0,0:11:41.00,0:11:41.96,S,,0,0,0,,обкладинку
Dialogue: 0,0:11:42.60,0:11:43.86,S,,0,0,0,,окремо текст
Dialogue: 0,0:11:44.00,0:11:45.36,S,,0,0,0,,текст з картинкою
Dialogue: 0,0:11:45.38,0:11:46.62,S,,0,0,0,,тому що треба ж поєднати
Dialogue: 0,0:11:46.64,0:11:47.40,S,,0,0,0,,правильно, щоб воно все
Dialogue: 0,0:11:47.42,0:11:49.43,S,,0,0,0,,вмістилося, і заклик до дій.
Dialogue: 0,0:11:49.47,0:11:51.07,S,,0,0,0,,Ці чотири типи слайдів –
Dialogue: 0,0:11:51.09,0:11:52.63,S,,0,0,0,,це наші основи.
Dialogue: 0,0:11:52.65,0:11:53.97,S,,0,0,0,,І далі ми можемо гратися
Dialogue: 0,0:11:53.99,0:11:56.25,S,,0,0,0,,взагодно, переміщати картинки
Dialogue: 0,0:11:56.27,0:11:56.81,S,,0,0,0,,туди і сюди
Dialogue: 0,0:11:56.83,0:11:57.93,S,,0,0,0,,але так ми хоча б
Dialogue: 0,0:11:57.95,0:11:59.35,S,,0,0,0,,побачимо, як це реально буде
Dialogue: 0,0:11:59.37,0:12:01.03,S,,0,0,0,,виглядати, чи достатньо у нас
Dialogue: 0,0:12:01.05,0:12:02.35,S,,0,0,0,,місця для картинки
Dialogue: 0,0:12:02.43,0:12:03.45,S,,0,0,0,,достатньо у нас місця для
Dialogue: 0,0:12:03.47,0:12:04.79,S,,0,0,0,,тексту і так далі.
Dialogue: 0,0:12:05.06,0:12:06.67,S,,0,0,0,,І тут важливий лайфхак
Dialogue: 0,0:12:06.71,0:12:07.73,S,,0,0,0,,що, так як я вже
Dialogue: 0,0:12:07.75,0:12:09.39,S,,0,0,0,,сказала, клод не генерує
Dialogue: 0,0:12:09.41,0:12:11.27,S,,0,0,0,,картинки. Але картинки і
Dialogue: 0,0:12:11.29,0:12:13.13,S,,0,0,0,,елементи нам скоріше за все
Dialogue: 0,0:12:13.15,0:12:15.25,S,,0,0,0,,знадобляться. І тут два таких
Dialogue: 0,0:12:15.27,0:12:17.40,S,,0,0,0,,лайфхаки важливих моменти.
Dialogue: 0,0:12:17.42,0:12:19.24,S,,0,0,0,,По-перше, я дуже рекомендую
Dialogue: 0,0:12:19.26,0:12:20.46,S,,0,0,0,,підключити таку штуку
Dialogue: 0,0:12:20.48,0:12:22.03,S,,0,0,0,,яка називається OpenRouter.
Dialogue: 0,0:12:22.05,0:12:23.40,S,,0,0,0,,І OpenRouter –
Dialogue: 0,0:12:23.42,0:12:24.68,S,,0,0,0,,це платформа
Dialogue: 0,0:12:24.70,0:12:26.84,S,,0,0,0,,в якій збережені всі моделі.
Dialogue: 0,0:12:26.88,0:12:27.81,S,,0,0,0,,Вообще всі.
Dialogue: 0,0:12:27.83,0:12:29.53,S,,0,0,0,,Ну, от прям всі.
Dialogue: 0,0:12:29.55,0:12:30.41,S,,0,0,0,,І для картинок
Dialogue: 0,0:12:30.43,0:12:31.11,S,,0,0,0,,і для тексту
Dialogue: 0,0:12:31.13,0:12:31.69,S,,0,0,0,,і для відео
Dialogue: 0,0:12:31.71,0:12:32.23,S,,0,0,0,,і для аудіо
Dialogue: 0,0:12:32.25,0:12:32.89,S,,0,0,0,,і вообще все
Dialogue: 0,0:12:32.91,0:12:33.69,S,,0,0,0,,що завгодно.
Dialogue: 0,0:12:33.83,0:12:34.75,S,,0,0,0,,Тобто, для тих
Dialogue: 0,0:12:34.77,0:12:36.03,S,,0,0,0,,хто займається відео з
Dialogue: 0,0:12:36.05,0:12:36.81,S,,0,0,0,,штучного інтелекту
Dialogue: 0,0:12:36.83,0:12:38.03,S,,0,0,0,,знаєте, як в Higgsfield
Dialogue: 0,0:12:38.05,0:12:39.03,S,,0,0,0,,у тебе є список
Dialogue: 0,0:12:39.05,0:12:40.15,S,,0,0,0,,у тебе є там Nano Banana
Dialogue: 0,0:12:40.17,0:12:40.69,S,,0,0,0,,є Kling
Dialogue: 0,0:12:40.71,0:12:41.23,S,,0,0,0,,є так само
Dialogue: 0,0:12:41.25,0:12:42.57,S,,0,0,0,,і ти платиш великі гроші
Dialogue: 0,0:12:42.59,0:12:43.45,S,,0,0,0,,за Higgsfield
Dialogue: 0,0:12:43.51,0:12:44.01,S,,0,0,0,,щоб, власне
Dialogue: 0,0:12:44.03,0:12:45.26,S,,0,0,0,,генерувати. Так от
Dialogue: 0,0:12:45.28,0:12:47.32,S,,0,0,0,,OpenRouter має всі ті самі
Dialogue: 0,0:12:47.34,0:12:49.29,S,,0,0,0,,моделі, але за ринковою ціною.
Dialogue: 0,0:12:49.31,0:12:51.33,S,,0,0,0,,Тобто, генерація у нас коштує
Dialogue: 0,0:12:51.35,0:12:53.19,S,,0,0,0,,там якийсь там декілька центів
Dialogue: 0,0:12:53.21,0:12:54.39,S,,0,0,0,,за відео
Dialogue: 0,0:12:54.41,0:12:55.36,S,,0,0,0,,картинку і так далі.
Dialogue: 0,0:12:55.38,0:12:56.88,S,,0,0,0,,За цією ж ринковою ціною
Dialogue: 0,0:12:56.90,0:12:58.02,S,,0,0,0,,ти можеш мати доступ до
Dialogue: 0,0:12:58.04,0:12:59.14,S,,0,0,0,,всіх моделей світу.
Dialogue: 0,0:12:59.22,0:13:00.62,S,,0,0,0,,Тобі просто треба підключити
Dialogue: 0,0:13:00.64,0:13:01.90,S,,0,0,0,,OpenRouter до Клоду
Dialogue: 0,0:13:01.92,0:13:02.54,S,,0,0,0,,і він
Dialogue: 0,0:13:02.56,0:13:03.76,S,,0,0,0,,якщо йому треба згенерувати
Dialogue: 0,0:13:03.78,0:13:04.86,S,,0,0,0,,картинку з нуля
Dialogue: 0,0:13:04.88,0:13:06.12,S,,0,0,0,,він піде туди
Dialogue: 0,0:13:06.14,0:13:06.54,S,,0,0,0,,там, типу
Dialogue: 0,0:13:06.56,0:13:07.74,S,,0,0,0,,абіз'яна на банані
Dialogue: 0,0:13:07.76,0:13:08.72,S,,0,0,0,,знаєте, отакі картинки.
Dialogue: 0,0:13:08.74,0:13:10.08,S,,0,0,0,,Він піде туди
Dialogue: 0,0:13:10.28,0:13:11.52,S,,0,0,0,,вибере якусь модель
Dialogue: 0,0:13:11.54,0:13:12.86,S,,0,0,0,,згенерує картинку за ці
Dialogue: 0,0:13:12.88,0:13:15.51,S,,0,0,0,,нещасні 2 центи і використає
Dialogue: 0,0:13:15.53,0:13:16.38,S,,0,0,0,,її в дизайні.
Dialogue: 0,0:13:16.40,0:13:17.82,S,,0,0,0,,Магія, я знаю
Dialogue: 0,0:13:17.84,0:13:18.46,S,,0,0,0,,я знаю.
Dialogue: 0,0:13:18.48,0:13:19.61,S,,0,0,0,,Другий лайфхак.
Dialogue: 0,0:13:19.63,0:13:20.65,S,,0,0,0,,Це настільки лайфхак
Dialogue: 0,0:13:20.67,0:13:21.89,S,,0,0,0,,скільки це важливий момент
Dialogue: 0,0:13:21.91,0:13:22.37,S,,0,0,0,,що те
Dialogue: 0,0:13:22.39,0:13:23.88,S,,0,0,0,,що чат в клоді
Dialogue: 0,0:13:23.90,0:13:25.78,S,,0,0,0,,він більш обмежений
Dialogue: 0,0:13:25.80,0:13:26.96,S,,0,0,0,,ніж код.
Dialogue: 0,0:13:26.98,0:13:27.64,S,,0,0,0,,Тобто в тебе є там
Dialogue: 0,0:13:27.66,0:13:28.70,S,,0,0,0,,невеличкий перемикач.
Dialogue: 0,0:13:28.72,0:13:29.58,S,,0,0,0,,Ти можеш бути в чаті
Dialogue: 0,0:13:29.60,0:13:31.00,S,,0,0,0,,можеш бути в коді.
Dialogue: 0,0:13:31.02,0:13:32.32,S,,0,0,0,,І чат в основному нам
Dialogue: 0,0:13:32.34,0:13:34.30,S,,0,0,0,,окей на 90 % задач
Dialogue: 0,0:13:34.32,0:13:35.88,S,,0,0,0,,Але саме монтаж у нас
Dialogue: 0,0:13:35.90,0:13:37.70,S,,0,0,0,,буде відбуватися в коді.
Dialogue: 0,0:13:37.77,0:13:39.59,S,,0,0,0,,І код має власний вихід
Dialogue: 0,0:13:39.61,0:13:41.47,S,,0,0,0,,в інтернет і власний термінал.
Dialogue: 0,0:13:41.49,0:13:42.17,S,,0,0,0,,І це означає
Dialogue: 0,0:13:42.19,0:13:43.25,S,,0,0,0,,що він може піти і
Dialogue: 0,0:13:43.27,0:13:44.75,S,,0,0,0,,пошукати якісь картинки.
Dialogue: 0,0:13:44.83,0:13:48.34,S,,0,0,0,,Наприклад, коли я робила відео
Dialogue: 0,0:13:48.36,0:13:49.84,S,,0,0,0,,про своє життя в В'єтнамі
Dialogue: 0,0:13:49.86,0:13:50.90,S,,0,0,0,,я попросила його зробити
Dialogue: 0,0:13:50.92,0:13:52.28,S,,0,0,0,,абсолютно інший стиль
Dialogue: 0,0:13:52.30,0:13:54.01,S,,0,0,0,,який буде нагадувати скраббук
Dialogue: 0,0:13:54.03,0:13:55.43,S,,0,0,0,,і там будуть використані
Dialogue: 0,0:13:55.45,0:13:57.13,S,,0,0,0,,реальні картинки
Dialogue: 0,0:13:57.51,0:13:58.33,S,,0,0,0,,реальних предметів
Dialogue: 0,0:13:58.35,0:13:59.43,S,,0,0,0,,тому що мені подобався цей
Dialogue: 0,0:13:59.45,0:14:01.06,S,,0,0,0,,стиль. Я сказала йому тільки
Dialogue: 0,0:14:01.08,0:14:02.14,S,,0,0,0,,це, я не шукала саме
Dialogue: 0,0:14:02.16,0:14:03.70,S,,0,0,0,,картинки, я не генерувала їх
Dialogue: 0,0:14:03.72,0:14:04.56,S,,0,0,0,,я їх не вирізала
Dialogue: 0,0:14:04.58,0:14:06.70,S,,0,0,0,,нічого. Він сам пішов
Dialogue: 0,0:14:06.72,0:14:07.84,S,,0,0,0,,тому що це був код
Dialogue: 0,0:14:07.94,0:14:08.80,S,,0,0,0,,він сам пішов
Dialogue: 0,0:14:08.82,0:14:09.92,S,,0,0,0,,він сам знайшов картинки
Dialogue: 0,0:14:09.94,0:14:11.12,S,,0,0,0,,він їх сам вирізав
Dialogue: 0,0:14:11.18,0:14:12.28,S,,0,0,0,,навіть не знаю як
Dialogue: 0,0:14:12.30,0:14:13.34,S,,0,0,0,,мабуть через OpenRouter
Dialogue: 0,0:14:13.36,0:14:13.97,S,,0,0,0,,я не знаю.
Dialogue: 0,0:14:13.99,0:14:15.08,S,,0,0,0,,Він сам їх вирізав і
Dialogue: 0,0:14:15.10,0:14:16.50,S,,0,0,0,,сам їх вставив в цей
Dialogue: 0,0:14:16.52,0:14:18.26,S,,0,0,0,,дизайн. Тому нам важливо це
Dialogue: 0,0:14:18.28,0:14:19.86,S,,0,0,0,,розуміти, коли ми будуємо нашу
Dialogue: 0,0:14:19.88,0:14:20.80,S,,0,0,0,,систему. Ну
Dialogue: 0,0:14:20.82,0:14:22.10,S,,0,0,0,,а якщо ви підете на
Dialogue: 0,0:14:22.12,0:14:25.13,S,,0,0,0,,мій курс по монтажу
Dialogue: 0,0:14:25.27,0:14:25.91,S,,0,0,0,,це правда
Dialogue: 0,0:14:25.93,0:14:28.45,S,,0,0,0,,ми зараз в процесі монтажу
Dialogue: 0,0:14:28.63,0:14:31.05,S,,0,0,0,,міні-курсу по AI-монтажу і
Dialogue: 0,0:14:31.07,0:14:32.75,S,,0,0,0,,AI-каруселям, де я буду прям
Dialogue: 0,0:14:32.77,0:14:33.81,S,,0,0,0,,чітко показувати
Dialogue: 0,0:14:33.83,0:14:35.19,S,,0,0,0,,покроково, куди ми тикаємо
Dialogue: 0,0:14:35.21,0:14:36.35,S,,0,0,0,,як ми це все налаштовуємо
Dialogue: 0,0:14:36.37,0:14:37.69,S,,0,0,0,,щоб це працювало в тебе
Dialogue: 0,0:14:37.71,0:14:38.19,S,,0,0,0,,так само
Dialogue: 0,0:14:38.21,0:14:38.68,S,,0,0,0,,як в мене.
Dialogue: 0,0:14:38.70,0:14:40.20,S,,0,0,0,,І там я розкажу детальніше
Dialogue: 0,0:14:40.22,0:14:41.26,S,,0,0,0,,як це все налаштувати
Dialogue: 0,0:14:41.28,0:14:42.51,S,,0,0,0,,щоб воно працювало.
Dialogue: 0,0:14:42.53,0:14:43.79,S,,0,0,0,,Але це теж дуже важливо
Dialogue: 0,0:14:43.81,0:14:45.45,S,,0,0,0,,розуміти, коли ми працюємо
Dialogue: 0,0:14:45.47,0:14:46.65,S,,0,0,0,,саме з Claude.
Dialogue: 0,0:14:46.67,0:14:47.19,S,,0,0,0,,І, в принципі
Dialogue: 0,0:14:47.21,0:14:48.91,S,,0,0,0,,з ChatGPT це працює схоже
Dialogue: 0,0:14:48.97,0:14:50.27,S,,0,0,0,,окрім як в нього є
Dialogue: 0,0:14:50.29,0:14:52.53,S,,0,0,0,,свій доступ до генерації
Dialogue: 0,0:14:52.55,0:14:53.73,S,,0,0,0,,картинок, і тобі не треба
Dialogue: 0,0:14:53.75,0:14:55.69,S,,0,0,0,,прям аж OpenRouter саме для
Dialogue: 0,0:14:55.71,0:14:56.77,S,,0,0,0,,картинок, тому що він їх
Dialogue: 0,0:14:56.79,0:14:58.87,S,,0,0,0,,може згенерувати прямо в чаті.
Dialogue: 0,0:14:59.10,0:14:59.67,S,,0,0,0,,Ну що
Dialogue: 0,0:14:59.69,0:15:00.71,S,,0,0,0,,на цьому етапі ми вже
Dialogue: 0,0:15:00.73,0:15:02.17,S,,0,0,0,,зробили наш базовий брендбук.
Dialogue: 0,0:15:02.19,0:15:03.53,S,,0,0,0,,Ми зробили окрему секцію для
Dialogue: 0,0:15:03.55,0:15:05.21,S,,0,0,0,,карусели. А що робити для
Dialogue: 0,0:15:05.23,0:15:06.25,S,,0,0,0,,рілсів? Тому що рілси –
Dialogue: 0,0:15:06.27,0:15:07.43,S,,0,0,0,,це абсолютно інше.
Dialogue: 0,0:15:07.55,0:15:08.75,S,,0,0,0,,І рілси хоч і можуть
Dialogue: 0,0:15:08.77,0:15:10.51,S,,0,0,0,,бути вписані нам в основний
Dialogue: 0,0:15:10.53,0:15:12.25,S,,0,0,0,,брендбук, але не повністю.
Dialogue: 0,0:15:12.27,0:15:13.57,S,,0,0,0,,Тому що у нас в
Dialogue: 0,0:15:13.59,0:15:14.93,S,,0,0,0,,анімації рілсів є
Dialogue: 0,0:15:14.95,0:15:15.61,S,,0,0,0,,власне, що?
Dialogue: 0,0:15:15.63,0:15:16.77,S,,0,0,0,,Правильно, анімація.
Dialogue: 0,0:15:16.83,0:15:17.85,S,,0,0,0,,Нам треба зрозуміти
Dialogue: 0,0:15:17.87,0:15:19.35,S,,0,0,0,,як нам це все занімувати
Dialogue: 0,0:15:19.37,0:15:20.87,S,,0,0,0,,щоб воно правильно вилітало
Dialogue: 0,0:15:20.89,0:15:22.75,S,,0,0,0,,з'являлось, і взагалі там дуже
Dialogue: 0,0:15:22.77,0:15:23.93,S,,0,0,0,,багато чого можеш зробити
Dialogue: 0,0:15:23.95,0:15:25.69,S,,0,0,0,,тому що елементи можуть бути
Dialogue: 0,0:15:25.71,0:15:26.91,S,,0,0,0,,ось тут перед тобою
Dialogue: 0,0:15:27.03,0:15:28.83,S,,0,0,0,,елементи можуть бути за тобою
Dialogue: 0,0:15:28.91,0:15:29.91,S,,0,0,0,,вирізаючи тебе
Dialogue: 0,0:15:30.09,0:15:31.57,S,,0,0,0,,і елементи можуть повністю
Dialogue: 0,0:15:31.59,0:15:32.75,S,,0,0,0,,перекривати екран
Dialogue: 0,0:15:33.25,0:15:34.91,S,,0,0,0,,і просто відбуватися на
Dialogue: 0,0:15:34.93,0:15:36.75,S,,0,0,0,,екрані. А іноді може
Dialogue: 0,0:15:36.77,0:15:37.83,S,,0,0,0,,відбуватися на екрані
Dialogue: 0,0:15:37.85,0:15:39.25,S,,0,0,0,,і ти можеш бути вирізана
Dialogue: 0,0:15:39.27,0:15:41.35,S,,0,0,0,,зеленим екраном на самому
Dialogue: 0,0:15:41.37,0:15:43.03,S,,0,0,0,,екрані, або в маленькому
Dialogue: 0,0:15:43.05,0:15:44.13,S,,0,0,0,,кружочку, як в туторіалі.
Dialogue: 0,0:15:44.15,0:15:45.58,S,,0,0,0,,Коротше, там купа всього.
Dialogue: 0,0:15:45.60,0:15:46.54,S,,0,0,0,,Так от
Dialogue: 0,0:15:46.56,0:15:47.50,S,,0,0,0,,є секретний промт
Dialogue: 0,0:15:47.52,0:15:48.37,S,,0,0,0,,який я вам даю.
Dialogue: 0,0:15:48.39,0:15:49.73,S,,0,0,0,,І є телеграм-бот.
Dialogue: 0,0:15:49.75,0:15:50.61,S,,0,0,0,,Що ви робите?
Dialogue: 0,0:15:50.63,0:15:51.41,S,,0,0,0,,Ви берете
Dialogue: 0,0:15:51.43,0:15:54.33,S,,0,0,0,,ви йдете і берете приклади
Dialogue: 0,0:15:54.35,0:15:56.35,S,,0,0,0,,рілсів. Свої або когось
Dialogue: 0,0:15:56.37,0:15:57.55,S,,0,0,0,,іншого, це не важливо.
Dialogue: 0,0:15:57.69,0:15:59.27,S,,0,0,0,,Копіюєте посилання на цей
Dialogue: 0,0:15:59.29,0:16:00.69,S,,0,0,0,,рілс. 3-5.
Dialogue: 0,0:16:00.71,0:16:02.13,S,,0,0,0,,Особливо не треба прямо
Dialogue: 0,0:16:02.37,0:16:03.49,S,,0,0,0,,але ви прямо пошукаєте те
Dialogue: 0,0:16:03.51,0:16:04.91,S,,0,0,0,,що вам реально подобається.
Dialogue: 0,0:16:04.93,0:16:05.37,S,,0,0,0,,От вам
Dialogue: 0,0:16:05.73,0:16:06.89,S,,0,0,0,,можливо, вам подобається не
Dialogue: 0,0:16:06.91,0:16:08.15,S,,0,0,0,,стиль, але вам подобається
Dialogue: 0,0:16:08.17,0:16:09.69,S,,0,0,0,,анімація. Тобто вам не
Dialogue: 0,0:16:09.71,0:16:10.51,S,,0,0,0,,подобається кольори
Dialogue: 0,0:16:10.53,0:16:11.51,S,,0,0,0,,вам не подобається шрифт
Dialogue: 0,0:16:11.53,0:16:13.27,S,,0,0,0,,але вам подобається анімація.
Dialogue: 0,0:16:13.29,0:16:14.03,S,,0,0,0,,Або навпаки
Dialogue: 0,0:16:14.05,0:16:15.07,S,,0,0,0,,вам не подобається анімація
Dialogue: 0,0:16:15.09,0:16:16.35,S,,0,0,0,,але вам подобається шрифт і
Dialogue: 0,0:16:16.37,0:16:17.84,S,,0,0,0,,як він з'являється.
Dialogue: 0,0:16:17.86,0:16:18.98,S,,0,0,0,,Коротше, ми шукаємо те
Dialogue: 0,0:16:19.00,0:16:20.58,S,,0,0,0,,що нам реально подобається.
Dialogue: 0,0:16:20.65,0:16:22.13,S,,0,0,0,,Ми беремо посилання на ці
Dialogue: 0,0:16:22.15,0:16:23.93,S,,0,0,0,,рілси і вставляємо їх в
Dialogue: 0,0:16:23.95,0:16:25.35,S,,0,0,0,,телеграм-бот, який називається
Dialogue: 0,0:16:25.37,0:16:26.11,S,,0,0,0,,SaveAsBot.
Dialogue: 0,0:16:26.13,0:16:27.84,S,,0,0,0,,Цей бот витягує з цього
Dialogue: 0,0:16:27.86,0:16:29.78,S,,0,0,0,,посилання в відеофайл
Dialogue: 0,0:16:29.80,0:16:31.86,S,,0,0,0,,який ми зберігаємо собі на
Dialogue: 0,0:16:31.88,0:16:34.12,S,,0,0,0,,комп'ютер. Потім ідемо в наш
Dialogue: 0,0:16:34.14,0:16:35.84,S,,0,0,0,,Claude Code. Вставляємо його в
Dialogue: 0,0:16:35.86,0:16:37.30,S,,0,0,0,,наш чат в Claude Code.
Dialogue: 0,0:16:37.32,0:16:38.58,S,,0,0,0,,Вставляємо це відео і
Dialogue: 0,0:16:38.60,0:16:39.64,S,,0,0,0,,вставляємо цей промт.
Dialogue: 0,0:16:39.66,0:16:40.68,S,,0,0,0,,Що цей промт робить?
Dialogue: 0,0:16:40.70,0:16:42.14,S,,0,0,0,,Він розбиває
Dialogue: 0,0:16:42.16,0:16:45.48,S,,0,0,0,,розрізає цей рілс на сцени.
Dialogue: 0,0:16:45.50,0:16:47.54,S,,0,0,0,,Їх буде величезна кількість.
Dialogue: 0,0:16:47.56,0:16:48.38,S,,0,0,0,,Нам це не важливо.
Dialogue: 0,0:16:48.40,0:16:49.28,S,,0,0,0,,Важливо йому.
Dialogue: 0,0:16:49.40,0:16:51.18,S,,0,0,0,,Він проаналізує кожну сцену
Dialogue: 0,0:16:51.20,0:16:52.04,S,,0,0,0,,подивиться її
Dialogue: 0,0:16:52.10,0:16:54.02,S,,0,0,0,,зрозуміє, як воно перейшло з
Dialogue: 0,0:16:54.04,0:16:54.98,S,,0,0,0,,одного в інший
Dialogue: 0,0:16:55.01,0:16:57.48,S,,0,0,0,,і зможе зробити тобі приклад
Dialogue: 0,0:16:57.50,0:16:58.89,S,,0,0,0,,того, як він це буде
Dialogue: 0,0:16:58.91,0:16:59.73,S,,0,0,0,,монтувати. Тобто
Dialogue: 0,0:16:59.75,0:17:00.15,S,,0,0,0,,знову ж таки
Dialogue: 0,0:17:00.17,0:17:01.39,S,,0,0,0,,ти даєш йому якось відео
Dialogue: 0,0:17:01.41,0:17:02.31,S,,0,0,0,,і кажеш
Dialogue: 0,0:17:02.33,0:17:03.71,S,,0,0,0,,згенеруй мені 10 секунд.
Dialogue: 0,0:17:03.73,0:17:05.23,S,,0,0,0,,І він згенерує тобі перші
Dialogue: 0,0:17:05.25,0:17:07.01,S,,0,0,0,,10 секунд цього рілса
Dialogue: 0,0:17:07.41,0:17:08.57,S,,0,0,0,,показуючи кожен з цих
Dialogue: 0,0:17:08.59,0:17:09.29,S,,0,0,0,,елементів. Тобто
Dialogue: 0,0:17:09.31,0:17:10.47,S,,0,0,0,,наприклад, в мене було три
Dialogue: 0,0:17:10.49,0:17:11.27,S,,0,0,0,,знову ж таки
Dialogue: 0,0:17:11.37,0:17:13.27,S,,0,0,0,,елементи. В мене є речі
Dialogue: 0,0:17:13.29,0:17:14.57,S,,0,0,0,,які стають зверху
Dialogue: 0,0:17:14.59,0:17:15.23,S,,0,0,0,,в мене є речі
Dialogue: 0,0:17:15.25,0:17:16.65,S,,0,0,0,,які за мною вирізають чимене
Dialogue: 0,0:17:16.67,0:17:18.03,S,,0,0,0,,і є анімації
Dialogue: 0,0:17:18.05,0:17:19.17,S,,0,0,0,,які повністю перекривають
Dialogue: 0,0:17:19.19,0:17:20.61,S,,0,0,0,,екран. І мені було важливо
Dialogue: 0,0:17:20.63,0:17:21.77,S,,0,0,0,,побачити всі три.
Dialogue: 0,0:17:21.79,0:17:22.33,S,,0,0,0,,І, власне
Dialogue: 0,0:17:22.35,0:17:23.59,S,,0,0,0,,я це і вписала в промт
Dialogue: 0,0:17:23.61,0:17:25.50,S,,0,0,0,,що покажи мені будь-яким
Dialogue: 0,0:17:25.52,0:17:27.96,S,,0,0,0,,чином, як ти перейшов в
Dialogue: 0,0:17:27.98,0:17:30.02,S,,0,0,0,,цьому відео від одного до
Dialogue: 0,0:17:30.04,0:17:31.38,S,,0,0,0,,іншого, до третього.
Dialogue: 0,0:17:31.40,0:17:32.78,S,,0,0,0,,І ми генеруємо оці перші
Dialogue: 0,0:17:32.80,0:17:33.42,S,,0,0,0,,10 секунд.
Dialogue: 0,0:17:33.44,0:17:34.24,S,,0,0,0,,Більше не треба
Dialogue: 0,0:17:34.26,0:17:35.93,S,,0,0,0,,тому що це втратить часу
Dialogue: 0,0:17:35.95,0:17:36.41,S,,0,0,0,,і гроші
Dialogue: 0,0:17:36.43,0:17:37.49,S,,0,0,0,,взагалі, непонятно на що.
Dialogue: 0,0:17:37.53,0:17:38.95,S,,0,0,0,,І коли ми бачимо це
Dialogue: 0,0:17:38.97,0:17:40.76,S,,0,0,0,,ми можемо сказати вирізай мене
Dialogue: 0,0:17:40.78,0:17:43.60,S,,0,0,0,,краще, елементи вище-нижче
Dialogue: 0,0:17:44.12,0:17:45.02,S,,0,0,0,,Субтитри менше
Dialogue: 0,0:17:45.04,0:17:47.56,S,,0,0,0,,більше. Зроби анімацію більше
Dialogue: 0,0:17:47.66,0:17:49.38,S,,0,0,0,,щоб вона переходила одне в
Dialogue: 0,0:17:49.40,0:17:50.48,S,,0,0,0,,інше, або навпаки
Dialogue: 0,0:17:50.84,0:17:52.34,S,,0,0,0,,щоб воно більше змінювалось
Dialogue: 0,0:17:52.36,0:17:53.90,S,,0,0,0,,постійно. Ти не використовував
Dialogue: 0,0:17:53.92,0:17:54.46,S,,0,0,0,,мої кольори
Dialogue: 0,0:17:54.48,0:17:55.12,S,,0,0,0,,давай світліше
Dialogue: 0,0:17:55.14,0:17:55.68,S,,0,0,0,,давай темніше.
Dialogue: 0,0:17:55.70,0:17:56.80,S,,0,0,0,,Коротше, ми починаємо йому
Dialogue: 0,0:17:56.82,0:17:57.90,S,,0,0,0,,накидувати правки.
Dialogue: 0,0:17:57.92,0:17:59.16,S,,0,0,0,,І в тебе буде декілька
Dialogue: 0,0:17:59.18,0:18:00.72,S,,0,0,0,,спроб. У мене вийшло
Dialogue: 0,0:18:00.74,0:18:01.92,S,,0,0,0,,коли я це робила
Dialogue: 0,0:18:02.06,0:18:04.52,S,,0,0,0,,в мене пішло спроб 10-15
Dialogue: 0,0:18:04.54,0:18:05.06,S,,0,0,0,,на те
Dialogue: 0,0:18:05.08,0:18:05.92,S,,0,0,0,,щоб дійти до реального
Dialogue: 0,0:18:05.94,0:18:07.18,S,,0,0,0,,результату. У вас
Dialogue: 0,0:18:07.20,0:18:08.36,S,,0,0,0,,звісно, все буде простіше
Dialogue: 0,0:18:08.38,0:18:09.20,S,,0,0,0,,тому що я вам дам
Dialogue: 0,0:18:09.22,0:18:09.98,S,,0,0,0,,всього інструкцію
Dialogue: 0,0:18:10.00,0:18:10.80,S,,0,0,0,,і вам не треба буде
Dialogue: 0,0:18:10.82,0:18:11.34,S,,0,0,0,,це робити.
Dialogue: 0,0:18:11.36,0:18:13.48,S,,0,0,0,,І взагалі-то я до цього
Dialogue: 0,0:18:13.50,0:18:15.08,S,,0,0,0,,розкадрування прийшла дуже
Dialogue: 0,0:18:15.10,0:18:16.70,S,,0,0,0,,пізно. Якщо ви зробите їх
Dialogue: 0,0:18:16.72,0:18:17.44,S,,0,0,0,,на початку
Dialogue: 0,0:18:17.46,0:18:19.44,S,,0,0,0,,то це буде набагато швидше.
Dialogue: 0,0:18:19.46,0:18:20.02,S,,0,0,0,,І я це знаю
Dialogue: 0,0:18:20.04,0:18:20.84,S,,0,0,0,,тому що я зробила це
Dialogue: 0,0:18:20.86,0:18:21.78,S,,0,0,0,,для свої клієнтки
Dialogue: 0,0:18:21.80,0:18:23.08,S,,0,0,0,,і я зробила їй цей
Dialogue: 0,0:18:23.10,0:18:25.02,S,,0,0,0,,AI-монтаж за 15 хвилин.
Dialogue: 0,0:18:25.28,0:18:26.08,S,,0,0,0,,І, власне
Dialogue: 0,0:18:26.10,0:18:26.92,S,,0,0,0,,все. Після того
Dialogue: 0,0:18:26.94,0:18:28.12,S,,0,0,0,,як ти це все зробила
Dialogue: 0,0:18:28.14,0:18:29.81,S,,0,0,0,,в тебе буде два файли.
Dialogue: 0,0:18:29.83,0:18:30.21,S,,0,0,0,,По факту
Dialogue: 0,0:18:30.23,0:18:30.95,S,,0,0,0,,в тебе буде одна
Dialogue: 0,0:18:30.97,0:18:32.75,S,,0,0,0,,дизайн-система з двома
Dialogue: 0,0:18:32.77,0:18:33.95,S,,0,0,0,,секціями. Одна секція –
Dialogue: 0,0:18:33.97,0:18:35.07,S,,0,0,0,,це базовий брендбук
Dialogue: 0,0:18:35.09,0:18:36.03,S,,0,0,0,,і інша секція –
Dialogue: 0,0:18:36.05,0:18:36.77,S,,0,0,0,,це каруселі.
Dialogue: 0,0:18:36.79,0:18:38.63,S,,0,0,0,,і будь-які інші секції під
Dialogue: 0,0:18:38.65,0:18:39.59,S,,0,0,0,,статичний дизайн
Dialogue: 0,0:18:39.61,0:18:40.57,S,,0,0,0,,який тобі потрібен.
Dialogue: 0,0:18:40.63,0:18:41.91,S,,0,0,0,,І окремо в тебе буде
Dialogue: 0,0:18:41.93,0:18:44.31,S,,0,0,0,,StyleMD, саме під монтаж
Dialogue: 0,0:18:44.33,0:18:45.97,S,,0,0,0,,рілсів, де описано
Dialogue: 0,0:18:45.99,0:18:47.01,S,,0,0,0,,власне, як ми робимо цю
Dialogue: 0,0:18:47.03,0:18:48.17,S,,0,0,0,,анімацію, які елементи ми
Dialogue: 0,0:18:48.19,0:18:50.07,S,,0,0,0,,використовуємо, як проходить
Dialogue: 0,0:18:50.09,0:18:51.23,S,,0,0,0,,весь цей рендер і так
Dialogue: 0,0:18:51.25,0:18:52.35,S,,0,0,0,,далі. І все
Dialogue: 0,0:18:52.39,0:18:54.33,S,,0,0,0,,насправді, ти готова до того
Dialogue: 0,0:18:54.35,0:18:54.93,S,,0,0,0,,щоб, власне
Dialogue: 0,0:18:54.95,0:18:57.25,S,,0,0,0,,переходити до самого дизайну і
Dialogue: 0,0:18:57.27,0:18:58.49,S,,0,0,0,,монтажу. Насправді
Dialogue: 0,0:18:58.51,0:18:59.65,S,,0,0,0,,для дизайну карусели ти вже
Dialogue: 0,0:18:59.67,0:19:01.23,S,,0,0,0,,готова. Я пропоную після того
Dialogue: 0,0:19:01.25,0:19:02.17,S,,0,0,0,,як ти це зробиш
Dialogue: 0,0:19:02.27,0:19:03.77,S,,0,0,0,,дати йому приклад будь-якого
Dialogue: 0,0:19:03.79,0:19:05.65,S,,0,0,0,,тексту, попросити його зробити
Dialogue: 0,0:19:05.67,0:19:06.97,S,,0,0,0,,з цього карусель.
Dialogue: 0,0:19:06.99,0:19:08.71,S,,0,0,0,,І ти побачиш цей дизайн
Dialogue: 0,0:19:09.00,0:19:10.64,S,,0,0,0,,вживу, як це буде
Dialogue: 0,0:19:10.83,0:19:12.21,S,,0,0,0,,Ти можеш вже постати свої
Dialogue: 0,0:19:12.23,0:19:14.58,S,,0,0,0,,карусели. Для монтажу є ще
Dialogue: 0,0:19:14.66,0:19:15.86,S,,0,0,0,,кількість кроків
Dialogue: 0,0:19:16.06,0:19:17.64,S,,0,0,0,,яку треба зробити для того
Dialogue: 0,0:19:17.66,0:19:18.50,S,,0,0,0,,щоб це працювало
Dialogue: 0,0:19:18.52,0:19:19.30,S,,0,0,0,,там і скіли
Dialogue: 0,0:19:19.34,0:19:20.54,S,,0,0,0,,і рендер у хмарі
Dialogue: 0,0:19:20.56,0:19:21.36,S,,0,0,0,,і GitHub
Dialogue: 0,0:19:21.38,0:19:22.48,S,,0,0,0,,і взагалі купа всього
Dialogue: 0,0:19:22.50,0:19:23.64,S,,0,0,0,,щоб воно працювало не просто
Dialogue: 0,0:19:23.66,0:19:25.64,S,,0,0,0,,швидко, а ще й дешево
Dialogue: 0,0:19:25.66,0:19:27.52,S,,0,0,0,,не вбивало твій комп'ютер і
Dialogue: 0,0:19:27.54,0:19:28.96,S,,0,0,0,,ще й працювало з телефону
Dialogue: 0,0:19:28.98,0:19:30.89,S,,0,0,0,,а не тільки на локальному
Dialogue: 0,0:19:30.91,0:19:31.72,S,,0,0,0,,комп'ютері.
Dialogue: 0,0:19:32.12,0:19:33.34,S,,0,0,0,,Тому я сподіваюся
Dialogue: 0,0:19:33.36,0:19:34.14,S,,0,0,0,,що ми зустрінемось.
Dialogue: 0,0:19:34.16,0:19:36.41,S,,0,0,0,,Я відкриваю передзапис поки що
Dialogue: 0,0:19:36.43,0:19:38.29,S,,0,0,0,,на мій курс
Dialogue: 0,0:19:38.31,0:19:41.21,S,,0,0,0,,міні-курс по AI-монтажу і по
Dialogue: 0,0:19:41.23,0:19:43.01,S,,0,0,0,,каруселям. Він буде короткий
Dialogue: 0,0:19:43.03,0:19:43.91,S,,0,0,0,,він буде дешевий
Dialogue: 0,0:19:43.93,0:19:44.99,S,,0,0,0,,він буде без підтримки
Dialogue: 0,0:19:45.01,0:19:45.91,S,,0,0,0,,він буде от в такому
Dialogue: 0,0:19:45.93,0:19:47.39,S,,0,0,0,,стилі, де я просто показую
Dialogue: 0,0:19:47.41,0:19:48.67,S,,0,0,0,,що робити крок за кроком
Dialogue: 0,0:19:48.69,0:19:50.83,S,,0,0,0,,з екраном і так далі.
Dialogue: 0,0:19:50.85,0:19:52.14,S,,0,0,0,,Тому, якщо тобі цікаво
Dialogue: 0,0:19:52.16,0:19:53.10,S,,0,0,0,,то ти зараз можеш
Dialogue: 0,0:19:53.12,0:19:54.02,S,,0,0,0,,поки він ще монтується
Dialogue: 0,0:19:54.04,0:19:55.12,S,,0,0,0,,взяти його за якоюсь
Dialogue: 0,0:19:55.14,0:19:56.54,S,,0,0,0,,нереальною знижкою
Dialogue: 0,0:19:56.64,0:19:57.78,S,,0,0,0,,яка просто не чувана
Dialogue: 0,0:19:57.80,0:19:58.50,S,,0,0,0,,не бачена.
Dialogue: 0,0:19:58.52,0:19:59.80,S,,0,0,0,,Тому якщо тобі цікаво
Dialogue: 0,0:19:59.82,0:20:01.68,S,,0,0,0,,то я залишаю посилання знизу.
Dialogue: 0,0:20:01.70,0:20:02.94,S,,0,0,0,,Якщо тобі сподобалось
Dialogue: 0,0:20:02.96,0:20:04.66,S,,0,0,0,,то обов'язково використай.
Dialogue: 0,0:20:04.68,0:20:05.36,S,,0,0,0,,Мені не треба
Dialogue: 0,0:20:05.38,0:20:06.30,S,,0,0,0,,щоб мене відмічало
Dialogue: 0,0:20:06.32,0:20:07.20,S,,0,0,0,,мені не треба нічого.
Dialogue: 0,0:20:07.28,0:20:08.96,S,,0,0,0,,Просто використай те
Dialogue: 0,0:20:08.98,0:20:10.22,S,,0,0,0,,що я зараз описала.
Dialogue: 0,0:20:10.28,0:20:12.54,S,,0,0,0,,Зроби першу карусель і відміть
Dialogue: 0,0:20:12.56,0:20:13.46,S,,0,0,0,,мене. Покажи мені
Dialogue: 0,0:20:13.48,0:20:14.46,S,,0,0,0,,як ти зробила цю першу
Dialogue: 0,0:20:14.48,0:20:16.64,S,,0,0,0,,карусель. І це буде краще
Dialogue: 0,0:20:16.66,0:20:17.74,S,,0,0,0,,за будь-які лайки
Dialogue: 0,0:20:17.76,0:20:18.72,S,,0,0,0,,за будь-які відмітки
Dialogue: 0,0:20:18.74,0:20:19.38,S,,0,0,0,,за будь-що.
Dialogue: 0,0:20:19.40,0:20:20.62,S,,0,0,0,,Якщо я побачу
Dialogue: 0,0:20:20.70,0:20:22.08,S,,0,0,0,,що ти реально почала
Dialogue: 0,0:20:22.10,0:20:23.24,S,,0,0,0,,створювати контент.
Dialogue: 0,0:20:23.26,0:20:24.22,S,,0,0,0,,Думаю, я сподіваюся
Dialogue: 0,0:20:24.24,0:20:25.70,S,,0,0,0,,що ми побачимося знову
Dialogue: 0,0:20:25.72,0:20:26.75,S,,0,0,0,,і па-па!
