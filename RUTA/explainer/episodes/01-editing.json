        {"action": "cloud.show", "shot": "whip>object_punch:cloud", "also": [{"action": "laptop.window", "args": {"name": "claude"}}, {"action": "cloud.upload", "at": 0.15}]},
        {"action": "phone.show", "shot": "whip>phone_dive", "caption": "Монтуєш *з телефона*",
          "also": [{"action": "phone.screen", "args": {"name": "claude"}}, {"action": "phone.type", "args": {"text": "/монтаж"}, "at": 0.2}, {"action": "phone.send", "at": 0.8}]},
        {"action": "reels.show", "shot": "whip>object_punch:reels", "caption": "Коли *завгодно*", "also": [{"action": "phone.hide"}, {"action": "reels.fill", "at": 0.1}, {"action": "cloud.done"}]},
        {"action": "ruta.pose", "args": {"pose": "coffee"}, "shot": "pull_back>room:final"},
        {"action": "ruta.pulse", "shot": "punch>character_close"}
