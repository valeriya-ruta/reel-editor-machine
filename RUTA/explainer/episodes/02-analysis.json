      "minus": {
        "caption": "Пояснюєш *щоразу*",
        "vo": "Він дає тобі аналіз, але тобі кожного разу треба пояснювати, що це були за рілси і як саме аналізувати.",
        "beats": [
          {"action": "laptop.newchat", "shot": "whip>screen",
            "also": [{"action": "buffer.hide"}, {"action": "claude.hide"}, {"action": "cable1.hide"}, {"action": "laptop.type", "args": {"text": "Рілс №3 був про ціни, №7 — розбір кейсу. Аналізуй так:"}, "at": 0.35}]},
          {"action": "ruta.pose", "args": {"pose": "bored"}, "shot": "whip>character_close"},
          {"action": "laptop.pulse", "shot": "whip>input_close"}
