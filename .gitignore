# Video and audio never go in the repo. Git stores every version of a binary
# forever, so one 580 MB recording would bloat the clone permanently for no
# benefit. Footage moves separately; the repo carries the system that edits it.
*.mp4
*.mov
*.webm
*.mkv
*.wav
*.m4a
*.mp3

# Ruta's pipeline lives in RUTA/ (Nika's in Nika/); paths below are from the repo root.

# Footage pulled from Drive arrives without a file extension, so the *.mp4
# rules above do not catch it. Ignore the whole landing folder.
RUTA/work/incoming/

# Rendered output
renders/
REEL-*.mp4

# Generated during a build — reproducible from the source
study/
RUTA/work/r*/*.jpg
RUTA/work/r*/*.png
RUTA/work/r*/stills/
RUTA/work/r*/ex/
RUTA/work/r*/mob/
RUTA/work/r*/band/
RUTA/work/r*/verify/
RUTA/work/ref/thumbs/

# Superseded: the loose-overlay-clip model, kept on disk but not in the system
# (STYLE.md §6)
ANIMATIONS/

# Other creators' reels, kept locally as reference only
Examples/
reference reel/

__pycache__/
*.pyc
node_modules/
.DS_Store
Thumbs.db
RUTA/assets/emoji/*.png

# Client carousels used as footage in reels 13/19 — client work, kept out of history
RUTA/work/carousels/
# Her media for upcoming reels (screenshots, recordings, product photos) - not for history
RUTA/work/media/

# Covers: Vercel link state and snapshot scratch
RUTA/covers/*/.vercel/
RUTA/covers/*/out/
RUTA/covers/deploy.log

# Per-take ASR intermediates for a batch; each take's utt.jsonl is copied into
# work/rNN/ once matched to its reel, and that copy is the tracked one
RUTA/work/b*/asr/

# Per-reel copies of the shared fonts / underlay / grain (work/b1021/scaffold.sh);
# the originals are tracked in assets/ and reel-07/assets/
RUTA/reel-*/assets/
RUTA/work/r*/mattelog/
RUTA/work/r*/seg/

# full-quality reels handed to her, not committed
00-FULL-QUALITY-*/

# Git's ignore rules are case-sensitive on Linux: iPhone footage arrives as .MOV
*.MOV
*.MP4
*.M4A
*.WAV
# Nika: her source footage and intermediates (frames, stills) stay out of history
Nika/work/src/
Nika/work/**/*.jpg
Nika/work/**/*.png

# cloud batch 2026-11-20
RUTA/work/inbox-1120/
RUTA/work/scratch/
RUTA/work/r*/utt/
RUTA/reel-*/assets/

# 5-years series: per-part render scratch and preview output
RUTA/work/5y/p*/
RUTA/work/5y/out/
RUTA/work/5y/cards/
